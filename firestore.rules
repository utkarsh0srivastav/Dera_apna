        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'startDate', 'endDate', 'cityId', 'areaId', 'sectorId', 'updatedAt']);
      allow delete: if isValidId(advertisementId) && isAdmin();
    }

    match /locations/{locationId} {
      allow get: if isValidId(locationId);
      allow list: if existing().level in ['state', 'district', 'city', 'area'];
      allow create: if isValidId(locationId) &&
        isValidLocationNode(incoming()) &&
        incoming().locationId == locationId &&
        incoming().createdAt == request.time &&
        (
          isAdmin() ||
          (
            (
              (isApprovedOwner() && incoming().createdBy == request.auth.uid) ||
              isActiveRegisteredCustomer(incoming().createdBy)
            ) &&
            incoming().level == 'area' &&
            incoming().custom == true &&
            incoming().status == 'active' &&
            incoming().cityId is string && incoming().cityId.size() >= 1 &&
            incoming().parentId == incoming().cityId &&
            incoming().stateId is string && incoming().stateId.size() >= 1 &&
            incoming().districtId is string && incoming().districtId.size() >= 1
          )
        );
      allow update: if isAdmin() &&
        isValidId(locationId) &&
        isValidLocationNode(incoming()) &&
        incoming().locationId == existing().locationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(locationId) && isAdmin();
    }

    match /pgPhotos/{photoId} {
      allow get: if isValidId(photoId);
      allow list: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(photoId) &&
        (isApprovedOwner() || isAdmin()) &&
        incoming().keys().hasAll(['photoId', 'pgId', 'ownerId', 'category', 'storagePath', 'contentType', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['photoId', 'pgId', 'ownerId', 'category', 'storagePath', 'contentType', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt']) &&
        incoming().photoId == photoId &&
        incoming().ownerId == request.auth.uid &&
        incoming().pgId is string && incoming().pgId.size() >= 1 && incoming().pgId.size() <= 128 &&
        (
          incoming().pgId == 'pg_' + request.auth.uid + '_init' ||
          (
            exists(/databases/$(database)/documents/pgListings/$(incoming().pgId)) &&
            get(/databases/$(database)/documents/pgListings/$(incoming().pgId)).data.ownerId == request.auth.uid
          ) ||
          isAdmin()
        ) &&
        incoming().category in ['main', 'gallery', 'rooms', 'facilities', 'bathrooms'] &&
        incoming().storagePath is string && incoming().storagePath.size() >= 1 && incoming().storagePath.size() <= 500 &&
        incoming().contentType is string && incoming().contentType.matches('image/(jpeg|jpg|png|webp)') &&
        incoming().sizeBytes is number && incoming().sizeBytes > 0 && incoming().sizeBytes <= 5242880 &&
        incoming().dataUrl is string && incoming().dataUrl.size() >= 32 && incoming().dataUrl.size() <= 800000 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(photoId) &&
        (isAdmin() || (isApprovedOwner() && existing().ownerId == request.auth.uid)) &&
        incoming().keys().hasAll(['photoId', 'pgId', 'ownerId', 'category', 'storagePath', 'contentType', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['photoId', 'pgId', 'ownerId', 'category', 'storagePath', 'contentType', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt']) &&
        incoming().photoId == existing().photoId &&
        incoming().pgId == existing().pgId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().category in ['main', 'gallery', 'rooms', 'facilities', 'bathrooms'] &&
        incoming().storagePath is string && incoming().storagePath.size() >= 1 && incoming().storagePath.size() <= 500 &&
        incoming().contentType is string && incoming().contentType.matches('image/(jpeg|jpg|png|webp)') &&
        incoming().sizeBytes is number && incoming().sizeBytes > 0 && incoming().sizeBytes <= 5242880 &&
        incoming().dataUrl is string && incoming().dataUrl.size() >= 32 && incoming().dataUrl.size() <= 800000 &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(photoId) && (
        isAdmin() ||
        (isApprovedOwner() && existing().ownerId == request.auth.uid)
      );
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().logId == logId &&
        incoming().timestamp == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
