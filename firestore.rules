        incoming().userId == existing().userId &&
        incoming().role == existing().role &&
        incoming().deviceId == existing().deviceId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['trusted', 'mobile', 'email', 'deviceId', 'createdAt', 'updatedAt']);
      allow delete: if isValidId(sessionId) && (
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (existing().role == 'CUSTOMER' && isActiveRegisteredCustomer(existing().userId)) ||
