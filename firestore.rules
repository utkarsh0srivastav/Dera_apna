        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    match /visits/{visitId} {
      allow get: if isValidId(visitId) && isSignedIn() && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(visitId) &&
        isValidVisit(incoming()) &&
