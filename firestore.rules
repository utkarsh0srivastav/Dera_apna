                incoming().propertyType == existing().propertyType &&
                incoming().gender == existing().gender
              )
            ) &&
            incoming().status in ['draft', 'pending', 'active', 'inactive'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'propertyName', 'propertyType', 'gender',
              'countryId', 'stateId', 'districtId', 'cityId', 'areaId', 'sectorId',
              'countryName', 'stateName', 'districtName', 'cityName', 'areaName', 'sectorName',
              'street', 'houseNumber', 'latitude', 'longitude',
              'mainPhotoUrl', 'mainPhotoPath', 'mainPhotoSize', 'mainPhotoContentType', 'mainPhotoUploadedAt',
              'galleryPhotos', 'bathroomPhotos', 'facilityPhotos', 'googleReviewUrl',
              'rent', 'securityDeposit', 'securityDuration',
              'hostelTotalPrice', 'hostelStayDuration', 'hostelPaymentModel', 'pricingModel',
              'acType', 'roomTypes', 'occupancy2Seater', 'occupancy3Seater', 'occupancy4Seater',
              'foodIncluded', 'mealFrequency',
              'laundry', 'washingMachine', 'wifi', 'ro', 'waterCooler', 'cooler',
              'parking', 'ventilation', 'bed', 'wardrobe', 'table', 'chair',
              'lunchService', 'transportation', 'gym', 'lift', 'gamingRoom',
              'washroomType', 'furnishing',
              'rules', 'bookingAvailable', 'roomAvailability', 'paymentTerms', 'securityTerms',
              'description', 'contactNumber', 'googleMapsUrl', 'googleReviewsUrl', 'photos',
              'identityLocked', 'status', 'updatedAt'
