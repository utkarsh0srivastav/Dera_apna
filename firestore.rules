        get(/databases/$(database)/documents/pgListings/$(incoming().pgId)).data.ownerId == incoming().ownerId;
      allow update: if false;
      allow delete: if isValidId(visitId) && isAdmin();
    }

    match /advertisements/{advertisementId} {
      allow get: if isValidId(advertisementId) && (
        existing().status == 'active' || isAdmin()
      );
      allow list: if existing().status == 'active' || isAdmin();
      allow create: if isAdmin() &&
        isValidId(advertisementId) &&
        isValidAdvertisement(incoming()) &&
        incoming().advertisementId == advertisementId &&
        incoming().createdByAdmin == request.auth.uid &&
