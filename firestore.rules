      );
      allow create: if isActiveRegisteredCustomer(incoming().customerId) &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().inquiryId == inquiryId &&
        incoming().customerName == get(/databases/$(database)/documents/customers/$(incoming().customerId)).data.name &&
        incoming().customerMobile == get(/databases/$(database)/documents/customers/$(incoming().customerId)).data.mobile &&
        incoming().customerEmail == get(/databases/$(database)/documents/customers/$(incoming().customerId)).data.email &&
        incoming().status == 'new' &&
        incoming().timestamp == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/pgListings/$(incoming().pgId)) &&
        get(/databases/$(database)/documents/pgListings/$(incoming().pgId)).data.ownerId == incoming().ownerId;
      allow update: if isSignedIn() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().inquiryId == existing().inquiryId &&
        incoming().customerId == existing().customerId &&
        incoming().pgId == existing().pgId &&
        incoming().ownerId == existing().ownerId &&
        incoming().timestamp == existing().timestamp &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        incoming().status is string && incoming().status in ['new', 'contacted', 'closed'] &&
        incoming().updatedAt is timestamp && incoming().updatedAt == request.time &&
