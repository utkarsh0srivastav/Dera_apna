    match /pgListings/{pgId} {
      allow get: if isValidId(pgId) && (
        existing().status == 'active' ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().status == 'active' ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdmin();
      allow create: if isApprovedOwner() &&
        isValidId(pgId) &&
        isValidPgListing(incoming()) &&
        incoming().pgId == pgId &&
        incoming().ownerId == request.auth.uid &&
        incoming().status in ['draft', 'pending', 'active', 'inactive'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(pgId) &&
        isValidPgListing(incoming()) &&
        incoming().pgId == existing().pgId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
