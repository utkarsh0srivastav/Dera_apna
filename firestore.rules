rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Only the single official Admin Google identity (utkarsh0srivastav@gmail.com) may bootstrap/authenticate as Admin
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'utkarsh0srivastav@gmail.com';
    }

    // Full Admin authorization requires BOTH verified official Admin identity AND verified Admin role document in Firestore
    function isAdmin() {
      return isBootstrappedAdmin() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveRegisteredCustomer(customerId) {
      return isValidId(customerId) &&
        exists(/databases/$(database)/documents/customers/$(customerId)) &&
        exists(/databases/$(database)/documents/customerSecrets/$(customerId)) &&
        get(/databases/$(database)/documents/customers/$(customerId)).data.status == 'active';
    }

    function isApprovedOwner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/owners/$(request.auth.uid)) &&
        !(
          'accountStatus' in get(/databases/$(database)/documents/owners/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.accountStatus in ['Blocked', 'Deleted', 'Rejected']
        ) &&
        (
          get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.accountStatus == 'Approved' ||
          get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.preRegistrationStatus == 'Approved' ||
          get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.status == 'Approved'
        );
    }

    function isOwnerOfPG(pgId) {
      return isApprovedOwner() &&
        exists(/databases/$(database)/documents/pgListings/$(pgId)) &&
        get(/databases/$(database)/documents/pgListings/$(pgId)).data.ownerId == request.auth.uid;
    }

    // 3. Entity Validation Helpers (Anti-Update-Gap)

    function isValidCustomer(data) {
      return data.keys().hasAll(['customerId', 'name', 'mobile', 'email', 'gender', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['customerId', 'authUid', 'name', 'mobile', 'email', 'gender', 'status', 'language', 'theme', 'createdAt', 'updatedAt']) &&
        isValidId(data.customerId) &&
        (!('authUid' in data) || isValidId(data.authUid)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 && data.mobile.matches('^[6-9][0-9]{9}$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.gender is string && data.gender in ['Male', 'Female'] &&
        data.status is string && data.status in ['active', 'blocked'] &&
        (!('language' in data) || (data.language is string && data.language in ['en', 'hi', 'hinglish', 'bn', 'te', 'mr', 'ta', 'ur', 'gu', 'kn', 'ml', 'or', 'pa', 'as', 'mai', 'sa', 'ks', 'bho', 'bgc'])) &&
        (!('theme' in data) || (data.theme is string && data.theme in ['light', 'dark'])) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerSecret(data) {
      return data.keys().hasAll(['customerId', 'pinHash', 'pinSalt', 'securityQuestion', 'securityAnswerHash', 'securityAnswerSalt', 'failedAttempts', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['customerId', 'authUid', 'pinHash', 'pinSalt', 'securityQuestion', 'securityAnswerHash', 'securityAnswerSalt', 'failedAttempts', 'createdAt', 'updatedAt']) &&
        isValidId(data.customerId) &&
        (!('authUid' in data) || isValidId(data.authUid)) &&
        data.pinHash is string && data.pinHash.size() >= 32 && data.pinHash.size() <= 256 &&
        data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 128 &&
        data.securityQuestion is string && data.securityQuestion.size() >= 5 && data.securityQuestion.size() <= 200 &&
        data.securityAnswerHash is string && data.securityAnswerHash.size() >= 32 && data.securityAnswerHash.size() <= 256 &&
        data.securityAnswerSalt is string && data.securityAnswerSalt.size() >= 16 && data.securityAnswerSalt.size() <= 128 &&
        data.failedAttempts is number && data.failedAttempts >= 0 && data.failedAttempts <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerMobileIndex(data) {
      return data.keys().hasAll(['mobile', 'customerId', 'securityQuestion', 'createdAt']) &&
        data.keys().hasOnly(['mobile', 'customerId', 'authUid', 'securityQuestion', 'createdAt']) &&
        data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 && data.mobile.matches('^[6-9][0-9]{9}$') &&
        isValidId(data.customerId) &&
        (!('authUid' in data) || isValidId(data.authUid)) &&
        data.securityQuestion is string && data.securityQuestion.size() >= 5 && data.securityQuestion.size() <= 200 &&
        data.createdAt is timestamp;
    }

    function isValidCustomerEmailIndex(data) {
      return data.keys().hasAll(['emailKey', 'email', 'customerId', 'createdAt']) &&
        data.keys().hasOnly(['emailKey', 'email', 'customerId', 'authUid', 'createdAt']) &&
        isValidId(data.emailKey) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        isValidId(data.customerId) &&
        (!('authUid' in data) || isValidId(data.authUid)) &&
        data.createdAt is timestamp;
    }

    function isValidOwnerPreRegistration(data) {
      return data.keys().hasAll(['mobile', 'name', 'email', 'approvedGoogleEmail', 'status', 'createdByAdmin', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['mobile', 'name', 'email', 'approvedGoogleEmail', 'linkedGoogleUid', 'activeDeviceIdHash', 'pinHash', 'pinSalt', 'status', 'createdByAdmin', 'createdAt', 'updatedAt']) &&
        data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 && data.mobile.matches('^[6-9][0-9]{9}$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.approvedGoogleEmail is string && data.approvedGoogleEmail.size() >= 3 && data.approvedGoogleEmail.size() <= 150 &&
        (!('linkedGoogleUid' in data) || (data.linkedGoogleUid is string && data.linkedGoogleUid.size() <= 128)) &&
        (!('activeDeviceIdHash' in data) || (data.activeDeviceIdHash is string && data.activeDeviceIdHash.size() <= 128)) &&
        data.status is string && data.status in ['Pending', 'Approved', 'Blocked', 'Deleted', 'Rejected'] &&
        data.createdByAdmin is string && data.createdByAdmin.size() >= 1 && data.createdByAdmin.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOwner(data) {
      return data.keys().hasAll(['ownerId', 'name', 'mobile', 'email', 'linkedGoogleUid', 'preRegistrationStatus', 'accountStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'uid', 'name', 'mobile', 'email', 'approvedGoogleEmail', 'linkedGoogleUid', 'activeDeviceIdHash', 'status', 'preRegistrationStatus', 'accountStatus', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 && data.mobile.matches('^[6-9][0-9]{9}$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.linkedGoogleUid is string && data.linkedGoogleUid.size() >= 1 && data.linkedGoogleUid.size() <= 128 &&
        (!('activeDeviceIdHash' in data) || (data.activeDeviceIdHash is string && data.activeDeviceIdHash.size() <= 128)) &&
        data.preRegistrationStatus is string && data.preRegistrationStatus in ['Pending', 'Approved', 'Blocked', 'Deleted', 'Rejected'] &&
        data.accountStatus is string && data.accountStatus in ['Pending', 'Approved', 'Blocked', 'Deleted', 'Rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDeviceLoginRequest(data) {
      return data.keys().hasAll(['requestId', 'userId', 'ownerId', 'ownerName', 'mobile', 'email', 'deviceIdHash', 'deviceName', 'platform', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'requestId', 'userId', 'ownerId', 'ownerName', 'mobile', 'email',
          'deviceIdHash', 'deviceName', 'platform', 'status',
          'createdAt', 'expiresAt', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'updatedAt'
        ]) &&
        isValidId(data.requestId) &&
        isValidId(data.userId) &&
        isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100 &&
        data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.deviceIdHash is string && data.deviceIdHash.size() >= 8 && data.deviceIdHash.size() <= 128 &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120 &&
        data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64 &&
        data.status is string && data.status in ['PENDING', 'APPROVED', 'REJECTED', 'EXPIRED', 'CANCELLED'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOwnerSecret(data) {
      return data.keys().hasAll(['ownerId', 'mobile', 'pinHash', 'pinSalt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'mobile', 'pinHash', 'pinSalt', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 &&
        data.pinHash is string && data.pinHash.size() >= 32 && data.pinHash.size() <= 256 &&
        data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['adminId', 'email', 'pinHash', 'pinSalt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['adminId', 'email', 'pinHash', 'pinSalt', 'createdAt', 'updatedAt']) &&
        isValidId(data.adminId) &&
        data.adminId == request.auth.uid &&
        data.email is string && data.email == 'utkarsh0srivastav@gmail.com' &&
        data.pinHash is string && data.pinHash.size() >= 32 && data.pinHash.size() <= 256 &&
        data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrustedDeviceSession(data) {
      return data.keys().hasAll(['sessionId', 'userId', 'role', 'mobile', 'email', 'deviceId', 'trusted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['sessionId', 'userId', 'role', 'mobile', 'email', 'deviceId', 'trusted', 'createdAt', 'updatedAt']) &&
        isValidId(data.sessionId) &&
        isValidId(data.userId) &&
        data.role is string && data.role in ['CUSTOMER', 'PG_OWNER', 'ADMIN'] &&
        (
          (data.role in ['PG_OWNER', 'ADMIN'] && isSignedIn() && data.userId == request.auth.uid) ||
          (data.role == 'CUSTOMER' && isActiveRegisteredCustomer(data.userId))
        ) &&
        data.mobile is string && data.mobile.size() <= 20 &&
        data.email is string && data.email.size() <= 150 &&
        data.deviceId is string && data.deviceId.size() >= 8 && data.deviceId.size() <= 128 &&
        data.trusted is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPgListing(data) {
      return data.keys().hasAll(['pgId', 'ownerId', 'propertyName', 'propertyType', 'gender', 'stateId', 'districtId', 'cityId', 'areaId', 'latitude', 'longitude', 'rent', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'pgId', 'ownerId', 'propertyName', 'propertyType', 'gender',
          'countryId', 'stateId', 'districtId', 'cityId', 'areaId', 'sectorId',
          'countryName', 'stateName', 'districtName', 'cityName', 'areaName', 'sectorName',
          'street', 'houseNumber', 'latitude', 'longitude',
          'mainPhotoUrl', 'mainPhotoPath', 'mainPhotoSize', 'mainPhotoContentType', 'mainPhotoUploadedAt',
          'googleReviewUrl', 'galleryPhotos', 'bathroomPhotos', 'facilityPhotos',
          'rent', 'securityDeposit', 'securityDuration',
          'hostelTotalPrice', 'hostelStayDuration', 'hostelPaymentModel', 'pricingModel',
          'acType', 'roomTypes', 'occupancy2Seater', 'occupancy3Seater', 'occupancy4Seater',
          'foodIncluded', 'mealFrequency',
          'laundry', 'washingMachine', 'wifi', 'ro', 'waterCooler', 'cooler',
          'parking', 'ventilation', 'bed', 'wardrobe', 'table', 'chair',
          'lunchService', 'transportation', 'gym', 'lift', 'gamingRoom',
          'washroomType', 'furnishing',
          'rules', 'bookingAvailable', 'roomAvailability', 'paymentTerms', 'securityTerms',
          'description', 'contactNumber', 'googleMapsUrl', 'googleReviewsUrl', 'photos',
          'identityLocked', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.pgId) &&
        isValidId(data.ownerId) &&
        data.propertyName is string && data.propertyName.size() >= 2 && data.propertyName.size() <= 120 &&
        data.propertyType is string && data.propertyType in ['PG', 'Hostel', 'Both'] &&
        data.gender is string && data.gender in ['Male', 'Female', 'Both'] &&
        data.stateId is string && data.stateId.size() >= 1 && data.stateId.size() <= 64 &&
        data.districtId is string && data.districtId.size() >= 1 && data.districtId.size() <= 64 &&
        data.cityId is string && data.cityId.size() >= 1 && data.cityId.size() <= 64 &&
        data.areaId is string && data.areaId.size() >= 1 && data.areaId.size() <= 128 &&
        data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
        data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
        (!('mainPhotoUrl' in data) || (data.mainPhotoUrl is string && data.mainPhotoUrl.size() <= 800000)) &&
        (!('mainPhotoPath' in data) || (data.mainPhotoPath is string && data.mainPhotoPath.size() <= 500)) &&
        (!('mainPhotoSize' in data) || (data.mainPhotoSize is number && data.mainPhotoSize >= 0 && data.mainPhotoSize <= 5242880)) &&
        (!('mainPhotoContentType' in data) || (data.mainPhotoContentType is string && data.mainPhotoContentType.size() <= 64)) &&
        (!('mainPhotoUploadedAt' in data) || (data.mainPhotoUploadedAt is timestamp || (data.mainPhotoUploadedAt is string && data.mainPhotoUploadedAt.size() <= 64))) &&
        (!('googleReviewUrl' in data) || (data.googleReviewUrl is string && data.googleReviewUrl.size() <= 500)) &&
        (!('galleryPhotos' in data) || (data.galleryPhotos is string && data.galleryPhotos.size() <= 800000)) &&
        (!('bathroomPhotos' in data) || (data.bathroomPhotos is string && data.bathroomPhotos.size() <= 800000)) &&
        (!('facilityPhotos' in data) || (data.facilityPhotos is string && data.facilityPhotos.size() <= 800000)) &&
        data.rent is number && data.rent >= 0 && data.rent <= 1000000 &&
        data.status is string && data.status in ['draft', 'pending', 'active', 'inactive', 'deleted'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['roomId', 'pgId', 'ownerId', 'roomType', 'occupancy', 'rent', 'availability', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'roomId', 'pgId', 'ownerId', 'roomType', 'occupancy',
          'rent', 'securityDeposit', 'securityDuration',
          'availability', 'status', 'description', 'facilities', 'photos',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.roomId) &&
        isValidId(data.pgId) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.roomType is string && data.roomType.size() >= 1 && data.roomType.size() <= 80 &&
        data.occupancy is string && data.occupancy in ['2 Seater', '3 Seater', '4 Seater'] &&
        data.rent is number && data.rent >= 0 && data.rent <= 1000000 &&
        (!('securityDeposit' in data) || (data.securityDeposit is number && data.securityDeposit >= 0 && data.securityDeposit <= 1000000)) &&
        (!('securityDuration' in data) || (data.securityDuration is number && data.securityDuration >= 0 && data.securityDuration <= 120)) &&
        data.availability is bool &&
        (!('status' in data) || (data.status is string && data.status in ['active', 'inactive', 'deleted'])) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
        (!('facilities' in data) || (data.facilities is string && data.facilities.size() <= 1500)) &&
        (!('photos' in data) || (data.photos is string && data.photos.size() <= 800000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['inquiryId', 'customerId', 'customerName', 'customerMobile', 'customerEmail', 'pgId', 'pgName', 'ownerId', 'status', 'timestamp', 'updatedAt']) &&
        data.keys().hasOnly(['inquiryId', 'customerId', 'customerName', 'customerMobile', 'customerEmail', 'pgId', 'pgName', 'ownerId', 'roomId', 'roomOccupancy', 'status', 'timestamp', 'createdAt', 'updatedAt']) &&
        isValidId(data.inquiryId) &&
        isValidId(data.customerId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.customerMobile is string && data.customerMobile.size() >= 10 && data.customerMobile.size() <= 15 &&
        data.customerEmail is string && data.customerEmail.size() <= 150 &&
        isValidId(data.pgId) &&
        data.pgName is string && data.pgName.size() >= 1 && data.pgName.size() <= 120 &&
        isValidId(data.ownerId) &&
        (!('roomId' in data) || data.roomId == null || isValidId(data.roomId)) &&
        (!('roomOccupancy' in data) || data.roomOccupancy == null || (data.roomOccupancy is string && data.roomOccupancy.size() <= 64)) &&
        data.status is string && data.status in ['new', 'contacted', 'closed'] &&
        data.timestamp is timestamp &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['reviewId', 'pgId', 'customerId', 'customerName', 'rating', 'comment', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reviewId', 'pgId', 'customerId', 'customerName', 'rating', 'comment', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.reviewId) &&
        isValidId(data.pgId) &&
        isValidId(data.customerId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 1000 &&
        data.status is string && data.status in ['published', 'hidden', 'flagged'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVisit(data) {
      return data.keys().hasAll(['visitId', 'pgId', 'ownerId', 'sessionId', 'source', 'timestamp']) &&
        data.keys().hasOnly(['visitId', 'pgId', 'ownerId', 'sessionId', 'source', 'timestamp']) &&
        isValidId(data.visitId) &&
        isValidId(data.pgId) &&
        isValidId(data.ownerId) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 64 &&
        data.timestamp is timestamp;
    }

    function isValidAdvertisement(data) {
      return data.keys().hasAll(['advertisementId', 'pgId', 'cityId', 'areaId', 'sectorId', 'status', 'startDate', 'endDate', 'createdByAdmin', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['advertisementId', 'pgId', 'cityId', 'areaId', 'sectorId', 'status', 'startDate', 'endDate', 'createdByAdmin', 'createdAt', 'updatedAt']) &&
        isValidId(data.advertisementId) &&
        isValidId(data.pgId) &&
        data.cityId is string && data.cityId.size() >= 1 && data.cityId.size() <= 64 &&
        data.areaId is string && data.areaId.size() <= 128 &&
        data.sectorId is string && data.sectorId.size() <= 128 &&
        data.status is string && data.status in ['draft', 'active', 'expired', 'cancelled'] &&
        data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 40 &&
        data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 40 &&
        data.createdByAdmin is string && data.createdByAdmin.size() >= 1 && data.createdByAdmin.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLocationNode(data) {
      return data.keys().hasAll(['locationId', 'level', 'parentId', 'name', 'hasSectors', 'createdAt']) &&
        data.keys().hasOnly([
          'locationId', 'areaId', 'level', 'parentId',
          'countryId', 'stateId', 'districtId', 'cityId',
          'name', 'normalizedName', 'type', 'custom',
          'createdBy', 'status', 'hasSectors',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.locationId) &&
        (!('areaId' in data) || isValidId(data.areaId)) &&
        data.level is string && data.level in ['state', 'district', 'city', 'area'] &&
        data.parentId is string && data.parentId.size() <= 128 &&
        (!('countryId' in data) || (data.countryId is string && data.countryId.size() <= 16)) &&
        (!('stateId' in data) || (data.stateId is string && data.stateId.size() <= 64)) &&
        (!('districtId' in data) || (data.districtId is string && data.districtId.size() <= 64)) &&
        (!('cityId' in data) || (data.cityId is string && data.cityId.size() <= 64)) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        !data.name.matches('.*[<>].*') &&
        (!('normalizedName' in data) || (data.normalizedName is string && data.normalizedName.size() >= 1 && data.normalizedName.size() <= 100)) &&
        (!('type' in data) || (data.type is string && data.type in ['SECTOR', 'LOCALITY', 'NEIGHBORHOOD', 'AREA', 'COLONY', 'TOWN_AREA', 'CUSTOM'])) &&
        (!('custom' in data) || data.custom is bool) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128)) &&
        (!('status' in data) || (data.status is string && data.status in ['active', 'merged', 'deleted'])) &&
        data.hasSectors is bool &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['logId', 'adminUid', 'action', 'targetType', 'targetId', 'metadata', 'timestamp']) &&
        data.keys().hasOnly(['logId', 'adminUid', 'action', 'targetType', 'targetId', 'metadata', 'timestamp']) &&
        isValidId(data.logId) &&
        data.adminUid is string && data.adminUid == request.auth.uid && data.adminUid.size() <= 128 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 64 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.metadata is string && data.metadata.size() <= 1000 &&
        data.timestamp is timestamp;
    }

    // 4. Collection Rules

    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if isAdmin();
      allow create: if isValidId(customerId) &&
        isValidCustomer(incoming()) &&
        incoming().customerId == customerId &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        !exists(/databases/$(database)/documents/customerMobileIndex/$(incoming().mobile));
      allow update: if isValidId(customerId) &&
        isValidCustomer(incoming()) &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if isValidId(customerId) && isAdmin();
    }

    match /customerSecrets/{customerId} {
      allow get: if isValidId(customerId) &&
        exists(/databases/$(database)/documents/customers/$(customerId));
      allow list: if false;
      allow create: if isValidId(customerId) &&
        isValidCustomerSecret(incoming()) &&
        incoming().customerId == customerId &&
        incoming().failedAttempts == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          exists(/databases/$(database)/documents/customers/$(customerId)) ||
          existsAfter(/databases/$(database)/documents/customers/$(customerId))
        );
      allow update: if isValidId(customerId) &&
